PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# OpenAI-compatible endpoint (optional). Defaults to https://api.openai.com/v1
# Examples:
#   OPENAI_BASE_URL=https://api.cerebras.ai/v1
#   OPENAI_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/v1
#   OPENAI_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/openai/v1
OPENAI_BASE_URL=
# auto | responses | chat  (auto: responses for api.openai.com, chat for others)
OPENAI_API_MODE=auto
# Comma-separated model ids for the main chat picker (replaces default gpt-5.x list)
# OPENAI_MODELS=xai.grok-4.3,zai.glm-5,openai.gpt-oss-120b
# OPENAI_MID_MODELS=xai.grok-4.3
# OPENAI_LOW_MODELS=openai.gpt-oss-20b
# Optional display labels: id:Label,id2:Label2
# OPENAI_MODEL_LABELS=xai.grok-4.3:Grok 4.3,zai.glm-5:GLM 5
# Accept any non-claude/non-gemini model id via the OpenAI adapter
# OPENAI_COMPAT_ANY_MODEL=true
# Per-request timeout for OpenAI-compatible calls (ms, default 120000)
# OPENAI_REQUEST_TIMEOUT_MS=120000

RESEND_API_KEY=your-resend-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token
