# Mike — regulated commercial workspace (HIPAA-aware / ITAR-conscious)
# Copy values from CloudFormation stack outputs + Secrets Manager.

PORT=3001
FRONTEND_URL=https://mike-regulated.YOUR_TAILNET.ts.net
DOWNLOAD_SIGNING_SECRET=replace-with-openssl-rand-hex-32
USER_API_KEYS_ENCRYPTION_SECRET=replace-with-long-random-secret

REGULATED_MODE=true
AWS_REGION=us-east-1

# --- Data plane (AWS-native) ---
# After Cognito+RDS adapters land, set:
# DATABASE_URL=postgres://...  (from Secrets Manager)
# COGNITO_USER_POOL_ID=us-east-1_xxx
# COGNITO_CLIENT_ID=xxx
# COGNITO_REGION=us-east-1

# Documents on S3 (instance role; no static keys)
S3_BUCKET_NAME=REPLACE_FROM_STACK_OUTPUT_DocsBucketName
# Leave R2_* unset in regulated mode

# --- Models: Bedrock Mantle only ---
OPENAI_API_KEY=REPLACE_FROM_SECRETS_MANAGER_mantle
OPENAI_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/v1
OPENAI_API_MODE=auto
OPENAI_COMPAT_ANY_MODEL=true
OPENAI_MODELS=xai.grok-4.3,zai.glm-5,openai.gpt-oss-120b,deepseek.v3.2
OPENAI_LOW_MODELS=openai.gpt-oss-20b
OPENAI_MODEL_LABELS=xai.grok-4.3:Grok 4.3,zai.glm-5:GLM 5

# --- Explicitly disabled in regulated env ---
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# COURTLISTENER_API_TOKEN=
# COURTLISTENER_BULK_DATA_ENABLED=false
